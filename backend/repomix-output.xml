    "pytest-asyncio>=1.4.0",
    "ruff>=0.17.1",
    "testcontainers[postgres]>=4.15.0",
    "types-pillow>=10.2.0.20240822",
    "types-pyyaml>=6.0.12.20261030",
]

# ---------------------------------------------------------------- Alembic
[tool.alembic]
script_location = "%(here)s/migrations"
prepend_sys_path = ["."]
# 20260101_1530_<rev>_<slug>.py: files sort chronologically in the IDE
file_template = "%%(year)d%%(month).2d%%(day).2d_%%(hour).2d%%(minute).2d_%%(rev)s_%%(slug)s"

[[tool.alembic.post_write_hooks]]
name = "ruff-fix"
type = "module"
module = "ruff"
options = "check --fix --quiet REVISION_SCRIPT_FILENAME"

[[tool.alembic.post_write_hooks]]
name = "ruff-format"
type = "module"
module = "ruff"
options = "format --quiet REVISION_SCRIPT_FILENAME"

# ------------------------------------------------------------------- Ruff
[tool.ruff]
line-length = 100
target-version = "py314"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E", "W",   # pycodestyle
    "F",        # pyflakes
    "I",        # import sorting
    "N",        # naming
    "UP",       # modern syntax
    "B",        # bugbear (likely bugs)
    "ANN",      # type hints on every function signature
    "ASYNC",    # async pitfalls
    "S",        # security
    "DTZ",      # no naive datetimes
    "C4", "SIM", "PT", "RUF", "T20",
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "ANN"]           # asserts and untyped fixtures are fine in tests
"migrations/versions/*" = ["E501"]      # generated code

# ------------------------------------------------------------------- Mypy
[tool.mypy]
strict = true
plugins = ["pydantic.mypy"]
mypy_path = "src"
explicit_package_bases = true
files = ["src", "tests", "migrations", "scripts"]

# ----------------------------------------------------------------- Pytest
[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
addopts = "-ra --strict-markers --strict-config"

# ---------------------------------------------------------- Import Linter
# Architecture rules, checked by `uv run lint-imports` (pre-commit + CI).
[tool.importlinter]
root_package = "app"

[[tool.importlinter.contracts]]
name = "Layers: main > api > modules > core (imports only point downward)"
type = "layers"
layers = ["app.main", "app.api", "app.modules", "app.core"]

[[tool.importlinter.contracts]]
name = "Modules: ingestion > enrichment > catalog > ingredients | scoring (no cycles, no sideways imports)"
type = "layers"
containers = ["app.modules"]
layers = ["ingestion", "enrichment", "catalog", "ingredients | scoring"]

# Each module's internals (models, repository) are private: only the module itself
# may import them. Everyone else goes through the module's public interface.
# When you add a repository.py (or a new module), add it to the matching contract.
[[tool.importlinter.contracts]]
name = "ingredients internals are private"
type = "protected"
protected_modules = ["app.modules.ingredients.models"]
allowed_importers = ["app.modules.ingredients"]

[[tool.importlinter.contracts]]
name = "catalog internals are private"
type = "protected"
protected_modules = ["app.modules.catalog.models"]
allowed_importers = ["app.modules.catalog"]

[[tool.importlinter.contracts]]
name = "enrichment internals are private"
type = "protected"
protected_modules = ["app.modules.enrichment.models"]
allowed_importers = ["app.modules.enrichment"]

[[tool.importlinter.contracts]]
name = "ingestion internals are private"
type = "protected"
protected_modules = ["app.modules.ingestion.models", "app.modules.ingestion.repository"]
allowed_importers = ["app.modules.ingestion"]

    }

    with patch(
        "app.modules.ingestion.sources.scraper.GenericScraperAdapter.fetch",
        new_callable=AsyncMock,
    ) as mock_fetch:
        mock_fetch.return_value = sample_extracted

        await scrape_url_task(
            {
                "url": "https://example.com/product/test-cream",
                "site_config": "default",
                "run_id": str(run.id),
            },
            db_session,

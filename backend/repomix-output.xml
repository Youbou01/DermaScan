    ingestion = IngestionService(db_session)
    run = await ingestion.create_run(source="scrape")
    await db_session.commit()

    sample_extracted = {
        "url": "https://example.com/product/test-cream",
        "barcode": "3600523823123",
        "name": "Test Hydrating Cream",

# Copy to `.env` (git-ignored) and change the passwords. NEVER commit `.env`.
# Every secret in this project comes from environment variables.

# --- Application (read by app.core.config.Settings) ---
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://skincare:CHANGE_ME@localhost:5432/skincare
DB_ECHO=false

# --- Local Postgres container (read by docker-compose.yml only) ---
# User / password / db name must match DATABASE_URL above.
POSTGRES_USER=skincare
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=skincare
POSTGRES_PORT=5432
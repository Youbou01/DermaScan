# Copy to `.env` (git-ignored). Restart `npm start` after changing it.
#
# SECURITY: every EXPO_PUBLIC_* value is embedded in the app bundle and readable by anyone who
# unpacks the app. NEVER put a secret, API key or credential here. Secrets live on the backend.

# Backend root, WITHOUT the /api/v1 suffix.
#   Real phone (Expo Go / dev build): your computer's LAN IP, e.g. http://192.168.1.20:8000
#   Android emulator:                 http://10.0.2.2:8000
#   iOS simulator:                    http://localhost:8000
# "localhost" on a real phone is the phone itself, not your computer.
# Production must be https:// (iOS and Android both block plain http in release builds).
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# true = serve fixtures instead of calling the backend (see MOB-02). API URL is then optional.
EXPO_PUBLIC_USE_MOCKS=false

# ==============================================================================
# DermaScan Mobile Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the `mobile/` directory:
#   PowerShell: Copy-Item .env.example .env
#   Bash/macOS: cp .env.example .env
#
# IMPORTANT: All EXPO_PUBLIC_* variables are embedded in client bundles.
# NEVER place secret API keys, tokens, or private credentials in this file.
# ==============================================================================

# Backend target URL (Origin only, WITHOUT `/api/v1`)
# By default, if left unset, DermaScan connects to the local backend:
#   http://localhost:8000
#
# Common local configurations:
#   iOS Simulator / Web:    http://localhost:8000
#   Android Emulator:       http://10.0.2.2:8000
#   Physical Phone (Wi-Fi): http://192.168.1.xxx:8000 (your machine's local LAN IP)
#
# Deployed cloud backend:
#   EXPO_PUBLIC_API_URL=https://dermascan-iorj.onrender.com
#
EXPO_PUBLIC_API_URL=http://localhost:8000

# Quick toggle to connect to the deployed cloud backend on Render.
# If true and EXPO_PUBLIC_API_URL is unset, automatically targets:
# https://dermascan-iorj.onrender.com
EXPO_PUBLIC_USE_CLOUD_BACKEND=false

# Serve mock fixtures for offline testing (true | false)
EXPO_PUBLIC_USE_MOCKS=false

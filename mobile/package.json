{
  "name": "dermascan-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "expo-check": "expo install --check --npm",
    "export:web": "expo export -p web",
    "build:pwa": "expo export -p web && workbox generateSW workbox-config.js",
    "api:generate": "uv run --project ../backend python scripts/export-openapi.py && npm run api:types",
    "api:types": "openapi-typescript openapi.json -o lib/api/generated/schema.d.ts",
    "lint": "oxlint --type-aware --type-check",
    "lint:css": "node scripts/lint-css.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "jest --ci",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "~0.4.2",
    "@expo/config": "^58.0.0",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "^5.108.1",
    "babel-plugin-inline-import": "~3.0.0",
    "babel-preset-expo": "~58.0.26",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "expo": "^58.0.26",

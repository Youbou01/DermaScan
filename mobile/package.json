{
  "name": "skincare-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "api:generate": "uv run --project ../backend python scripts/export-openapi.py && npm run api:types",
    "api:types": "openapi-typescript openapi.json -o src/api/generated/schema.d.ts && prettier --write openapi.json src/api/generated/schema.d.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --ci",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.0",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.28.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.30.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  }
}

    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.3.5",
    "test-renderer": "^1.0.0",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.0",
  "expo": {

    files: ['eslint.config.js'],
    languageOptions: { globals: { __dirname: 'readonly' } },
  },
  {
    files: ['**/*.{ts,tsx}'],
    languageOptions: {
      // Needed by the type-aware rules below (no-floating-promises, ...).
      parserOptions: { projectService: true, tsconfigRootDir: __dirname },

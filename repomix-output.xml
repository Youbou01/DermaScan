#!/usr/bin/env python3
"""Task E1: Open Beauty Facts Data-Source Spike."""

# ruff: noqa: S108, S310, T201
import gzip
import json
import urllib.request
from collections import Counter
from pathlib import Path

DUMP_URL = "https://static.openbeautyfacts.org/data/openbeautyfacts-products.jsonl.gz"
DUMP_PATH = Path("/tmp/openbeautyfacts-products.jsonl.gz")


def main() -> None:
    if not DUMP_PATH.exists():
        print(f"Downloading {DUMP_URL} to {DUMP_PATH}...")
        req = urllib.request.Request(DUMP_URL, headers={"User-Agent": "DermaScan-Spike/1.0"})
        with urllib.request.urlopen(req) as resp, open(DUMP_PATH, "wb") as out:
            out.write(resp.read())

    total = 0
    has_ingredients = 0
    has_categories = 0
    has_both = 0
    tn_619_total = 0
    tn_619_usable = 0
    top_categories: Counter[str] = Counter()

    with gzip.open(DUMP_PATH, "rt", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if not line.strip():
                continue
            total += 1
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue

            code = str(row.get("code") or "").strip()
            ing_text = str(row.get("ingredients_text") or "").strip()
            ing_list = row.get("ingredients") or []
            cats = row.get("categories_tags") or []

            ing_ok = bool(ing_text) or (isinstance(ing_list, list) and len(ing_list) > 0)
            cat_ok = isinstance(cats, list) and len(cats) > 0

            if ing_ok:
                has_ingredients += 1
            if cat_ok:
                has_categories += 1
                for c in cats:
                    if isinstance(c, str):
                        top_categories[c] += 1
            if ing_ok and cat_ok and code:
                has_both += 1

            clean_code = code[1:] if len(code) == 14 and code.startswith("0") else code
            if clean_code.startswith("619"):
                tn_619_total += 1
                if ing_ok:
                    tn_619_usable += 1

    print("\n================ E1 SPIKE REPORT ================")
    print(f"Total products in OBF dump          : {total:,}")
    ing_pct = has_ingredients / max(1, total) * 100
    print(f"Products with ingredients           : {has_ingredients:,} ({ing_pct:.1f}%)")
    cat_pct = has_categories / max(1, total) * 100
    print(f"Products with categories_tags       : {has_categories:,} ({cat_pct:.1f}%)")
    both_pct = has_both / max(1, total) * 100
    print(f"Products with barcode + ing + cat   : {has_both:,} ({both_pct:.1f}%)")
    print(f"Tunisian barcodes (619*) total      : {tn_619_total:,}")
    print(f"Tunisian barcodes (619*) w/ ingred. : {tn_619_usable:,}")
    print("\nTop 25 Category Tags (for Task E3 mapping):")
    for tag, count in top_categories.most_common(25):
        print(f"  {tag:<40} {count:,}")


if __name__ == "__main__":
    main()
</file>

<file path="backend/scripts/recompute_scores.py">
import asyncio
import logging
import sys
from pathlib import Path

BACKEND_DIR = Path(__file__).resolve().parents[1]
sys.path.append(str(BACKEND_DIR))

# ruff: noqa: E402
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import selectinload

from app.core.config import Settings
from app.core.database import create_engine, create_session_factory
from app.core.enums import RiskLevel as CoreRiskLevel
from app.modules.catalog.models import Product
from app.modules.ingredients.models import Ingredient
from app.modules.scoring.engine import (
    SCORING_VERSION,
    IngredientPositionInput,
    RiskLevel,
    ScoreBand,
    calculate_score,
)

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

BAND_TO_CORE_RISK: dict[ScoreBand, CoreRiskLevel] = {
    ScoreBand.GOOD: CoreRiskLevel.LOW,
    ScoreBand.MODERATE: CoreRiskLevel.MODERATE,
    ScoreBand.POOR: CoreRiskLevel.HIGH,
    ScoreBand.INSUFFICIENT_DATA: CoreRiskLevel.UNKNOWN,
}


async def recompute_stale_products(db: AsyncSession, batch_size: int = 100) -> int:
    """Finds products with missing or outdated scoring_version and updates them."""
    stmt = (
        select(Product)
        .options(selectinload(Product.ingredients))
        .where((Product.scoring_version.is_(None)) | (Product.scoring_version < SCORING_VERSION))
        .limit(batch_size)
    )
    result = await db.execute(stmt)
    stale_products = result.scalars().all()

    if not stale_products:
        return 0

    updated_count = 0
    for product in stale_products:
        input_items: list[IngredientPositionInput] = []
        for pi in product.ingredients:
            risk = RiskLevel.UNKNOWN
            if pi.ingredient_id is not None:
                ing_res = await db.execute(
                    select(Ingredient).where(Ingredient.id == pi.ingredient_id)
                )
                ing = ing_res.scalar_one_or_none()
                if ing is not None:
                    risk = RiskLevel(ing.risk_level.value)

            input_items.append(IngredientPositionInput(risk_level=risk, position=pi.position))

        score_output = calculate_score(input_items)

        product.score = score_output.score
        product.score_band = BAND_TO_CORE_RISK[score_output.band]
        product.score_coverage = score_output.coverage
        product.scoring_version = score_output.scoring_version
        updated_count += 1

    await db.commit()
    logger.info(
        "Recomputed scores for %d products (version %d).",
        updated_count,
        SCORING_VERSION,
    )
    return updated_count


async def main() -> None:
    settings = Settings()
    engine = create_engine(settings)
    session_factory = create_session_factory(engine)

    logger.info("Starting score recomputation CLI job...")
    total_updated = 0

    async with session_factory() as db:
        while True:
            count = await recompute_stale_products(db, batch_size=200)
            if count == 0:
                break
            total_updated += count

    logger.info("Recomputation complete. Total products updated: %d", total_updated)
    await engine.dispose()


if __name__ == "__main__":
    asyncio.run(main())

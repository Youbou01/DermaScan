    "image_url",
    "category",
    "score",
    "score_band",
    "score_coverage",
    "ingredients",
}
INGREDIENT_KEYS = {"position", "name", "inci_name", "matched", "risk_level", "rationale"}


async def add_product(
    session: AsyncSession,
    rows: list[tuple[int, str, Ingredient | None]] | None = None,
    **overrides: object,
) -> Product:
    """Persist a product whose label rows are (position, printed text, ingredient or None)."""
    product = make_product(**overrides)
    product.ingredients = [
        ProductIngredient(
            position=position,
            raw_text=text,
            ingredient_id=ingredient.id if ingredient else None,
        )
        for position, text, ingredient in (rows or [])
    ]
    session.add(product)
    await session.flush()
    return product



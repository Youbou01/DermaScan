        "40063813339",  # 11 digits
        "40063813339AB",  # letters
        "%20",  # blank
        "0",
    ],
)
async def test_malformed_barcode_is_a_422_invalid_barcode(
    client: httpx.AsyncClient, scanned: str
) -> None:

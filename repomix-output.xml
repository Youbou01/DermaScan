<file path="backend/scripts/seed_demo.py">
"""DEV ONLY: inserts a handful of demo ingredients and products so the API has something to show.

    uv run python scripts/seed_demo.py

It runs the real pipeline (label text -> parse -> match -> store), so it also shows how
B2-B4 fit together. It is safe to run twice. Real data will come from the ingredient seed
loader (task B5) and the Open Beauty Facts importer (task E2); this script goes away then.
Scores stay empty until the scoring module exists (task C1).
"""

import asyncio

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.config import get_settings
from app.core.database import create_engine, create_session_factory
from app.core.enums import RiskLevel
from app.modules.catalog.enums import ProductSource
from app.modules.catalog.gtin import compute_check_digit
from app.modules.catalog.models import (
    Brand,
    Category,
    CategoryTranslation,
    Product,
    ProductIngredient,
)
from app.modules.ingredients import IngredientService, normalize, parse_ingredient_label
from app.modules.ingredients.models import Ingredient, IngredientAlias, IngredientTranslation

# (INCI name, risk, extra names, {locale: rationale}, source)
INGREDIENTS: list[tuple[str, RiskLevel, list[str], dict[str, str], str | None]] = [
    ("AQUA", RiskLevel.LOW, ["Water", "Eau"], {}, None),
    ("GLYCERIN", RiskLevel.LOW, ["Glycerine", "Glycérine", "E422"], {}, None),
    ("CETEARYL ALCOHOL", RiskLevel.LOW, ["Alcool cétéarylique"], {}, None),
    ("TOCOPHEROL", RiskLevel.LOW, ["Vitamin E", "Vitamine E"], {}, None),
    ("CITRIC ACID", RiskLevel.LOW, ["Acide citrique", "E330"], {}, None),
    (
        "PARFUM",
        RiskLevel.MODERATE,
        ["Fragrance", "Parfum (Fragrance)"],
        {
            "en": "Undisclosed fragrance mixtures can contain allergens.",
            "fr": "Les parfums non détaillés peuvent contenir des allergènes.",
        },
        "Demo data (not a real assessment)",
    ),
    (
        "PROPYLPARABEN",
        RiskLevel.HIGH,
        ["Propyl paraben"],
        {"en": "Restricted preservative (demo text)."},
        "Demo data (not a real assessment)",
    ),
]

# (12-digit body, name, brand, label)
PRODUCTS: list[tuple[str, str, str, str]] = [
    (
        "619000000001",
        "Soft Day Cream",
        "Demo Brand",
        "Ingredients: Aqua (Water), Glycerin, Cetearyl Alcohol, Parfum (Fragrance), "
        "Tocopherol*, Citric Acid. +/- CI 77891",
    ),
    (
        "619000000002",
        "Crème Hydratante Douce",
        "Marque Démo",
        "Ingrédients : Eau, Glycérine, Alcool cétéarylique, Propylparaben, Extrait mystère",
    ),
    (
        "619000000003",
        "Mystery Serum",
        "Demo Brand",
        "Aqua, Rare Botanical Extract, Unknown Complex",
    ),
]


def unique_aliases(names: list[str]) -> dict[str, str]:
    """normalized key -> first spelling. "Glycerine" and "Glycérine" collapse to the same key,
    and the database (rightly) refuses two aliases with one key."""
    keys: dict[str, str] = {}
    for name in names:
        keys.setdefault(normalize(name), name)
    return keys


async def seed(session: AsyncSession) -> None:
    category = await session.scalar(select(Category).where(Category.slug == "moisturizer"))
    if category is None:
        category = Category(
            slug="moisturizer",
            translations=[
                CategoryTranslation(locale="en", name="Moisturizer"),
                CategoryTranslation(locale="fr", name="Hydratant"),
            ],
        )
        session.add(category)

    for inci, risk, extra_names, rationale, source in INGREDIENTS:
        if await session.scalar(select(Ingredient.id).where(Ingredient.inci_name == inci)):
            continue
        session.add(
            Ingredient(
                inci_name=inci,
                risk_level=risk,
                source_ref=source,
                aliases=[
                    IngredientAlias(alias=name, normalized_alias=key)
                    for key, name in unique_aliases([inci, *extra_names]).items()
                ],
                translations=[
                    IngredientTranslation(locale=loc, rationale=text)
                    for loc, text in rationale.items()
                ],
            )
        )
    await session.flush()

    ingredients = IngredientService(session)
    for body, name, brand_name, label in PRODUCTS:
        barcode = body + str(compute_check_digit(body))
        if await session.scalar(select(Product.id).where(Product.barcode == barcode)):
            continue
        brand = await session.scalar(select(Brand).where(Brand.name == brand_name))
        if brand is None:
            brand = Brand(name=brand_name)
            session.add(brand)
            await session.flush()

        parsed = parse_ingredient_label(label)  # B3
        matches = await ingredients.match([item.text for item in parsed])  # B4
        session.add(
            Product(
                barcode=barcode,
                name=name,
                brand_id=brand.id,
                primary_category_id=category.id,
                raw_ingredients_text=label,
                source=ProductSource.MANUAL,
                ingredients=[
                    ProductIngredient(
                        position=item.position, raw_text=item.text, ingredient_id=m.ingredient_id
                    )
                    for item, m in zip(parsed, matches, strict=True)
                ],
            )
        )
        print(f"{barcode}  {name}")  # noqa: T201
    await session.commit()


async def main() -> None:
    engine = create_engine(get_settings())
    async with create_session_factory(engine)() as session:
        await seed(session)
    await engine.dispose()


if __name__ == "__main__":
    asyncio.run(main())
</file>

<file path="backend/scripts/seed_home_sample.py">
"""DEV ONLY: insert ~30 sample products for manual home-feed testing.

    uv run python scripts/seed_home_sample.py
    uv run python scripts/seed_home_sample.py --purge

Uses valid GTIN-13 barcodes (D3 check digit). Categories must already be seeded
(`uv run python scripts/seed_categories.py`). Safe to re-run: skips existing barcodes.
"""

from __future__ import annotations

import argparse
import asyncio
from datetime import UTC, datetime, timedelta

from sqlalchemy import delete, func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.config import get_settings
from app.core.database import create_engine, create_session_factory
from app.core.enums import RiskLevel
from app.modules.catalog.enums import ProductSource
from app.modules.catalog.gtin import compute_check_digit
from app.modules.catalog.models import Brand, Category, Product

# 12-digit bodies; check digit appended at insert time. Prefix 619 = Tunisia.
SAMPLE_BODY_START = 619000100000
SAMPLE_COUNT = 30
SOURCE_ID_PREFIX = "home-sample-"


async def _category_ids(session: AsyncSession) -> dict[str, object]:
    rows = (await session.execute(select(Category.slug, Category.id))).all()
    return dict(rows)


async def seed(session: AsyncSession) -> int:
    categories = await _category_ids(session)
    if "moisturizer" not in categories:
        msg = "Categories missing. Run: uv run python scripts/seed_categories.py"
        raise SystemExit(msg)

    brand = await session.scalar(select(Brand).where(Brand.name == "Home Sample Brand"))
    if brand is None:
        brand = Brand(name="Home Sample Brand")
        session.add(brand)
        await session.flush()

    child_slugs = [
        "cleanser",
        "toner",
        "serum",
        "moisturizer",
        "sunscreen",
        "body-lotion",
        "lip-care",
    ]
    created = 0
    base = datetime(2026, 1, 1, tzinfo=UTC)
    for i in range(SAMPLE_COUNT):
        body = str(SAMPLE_BODY_START + i)
        barcode = body + str(compute_check_digit(body))
        if await session.scalar(select(Product.id).where(Product.barcode == barcode)):
            continue
        slug = child_slugs[i % len(child_slugs)]
        # Mix: scored, unscored, and "insufficient data" (unknown band).
        if i % 7 == 0:
            score, band, coverage = None, RiskLevel.UNKNOWN, None
        elif i % 11 == 0:
            score, band, coverage = 40, RiskLevel.UNKNOWN, 0.2
        else:
            score = 55 + (i % 40)
            band = (
                RiskLevel.LOW
                if score >= 80
                else RiskLevel.MODERATE
                if score >= 60
                else RiskLevel.HIGH
            )
            coverage = 0.85
        session.add(
            Product(
                barcode=barcode,
                name=f"Sample Product {i + 1:02d}",
                brand_id=brand.id,
                primary_category_id=categories[slug],
                image_url=f"https://example.test/sample/{i + 1}.jpg" if i % 3 else None,
                score=score,
                score_band=band,
                score_coverage=coverage,
                scoring_version=1 if score is not None else None,
                source=ProductSource.MANUAL,
                source_id=f"{SOURCE_ID_PREFIX}{i + 1:02d}",
                created_at=base + timedelta(hours=i),
            )
        )
        created += 1
        print(f"{barcode}  Sample Product {i + 1:02d}  score={score}")  # noqa: T201
    await session.commit()
    return created


async def purge(session: AsyncSession) -> int:
    count = await session.scalar(
        select(func.count())
        .select_from(Product)
        .where(Product.source_id.like(f"{SOURCE_ID_PREFIX}%"))
    )
    await session.execute(delete(Product).where(Product.source_id.like(f"{SOURCE_ID_PREFIX}%")))
    await session.commit()
    return int(count or 0)


async def main() -> None:
    parser = argparse.ArgumentParser(description="Seed or purge home-feed sample products.")
    parser.add_argument(
        "--purge", action="store_true", help="Remove products created by this script."
    )
    args = parser.parse_args()
    engine = create_engine(get_settings())
    async with create_session_factory(engine)() as session:
        if args.purge:
            removed = await purge(session)
            print(f"Removed {removed} sample product(s).")  # noqa: T201
        else:
            created = await seed(session)
            print(f"Inserted {created} sample product(s).")  # noqa: T201
    await engine.dispose()


if __name__ == "__main__":
    asyncio.run(main())
</file>


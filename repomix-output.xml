<file path="backend/src/app/core/errors.py">
"""Domain exceptions and the error response shape (RFC 9457 "problem details").

Services raise subclasses of `AppError`; the API layer turns them into
`application/problem+json` responses (see `app/api/error_handlers.py`).
Modules define their own specific errors by subclassing, e.g. in catalog/exceptions.py:

    class ProductNotFoundError(NotFoundError):
        code = "product-not-found"
        title = "Product not found"

The mobile app switches on the response's `type` (derived from `code`), never on `detail`.
"""

from typing import Any, ClassVar

from pydantic import BaseModel


class ProblemDetails(BaseModel):
    """Error body. Declared so it appears in the OpenAPI schema (typed client)."""

    type: str
    title: str
    status: int
    detail: str | None = None
    instance: str | None = None  # the request path
    request_id: str | None = None
    errors: list[dict[str, Any]] | None = None  # only for request-validation failures


class AppError(Exception):
    status_code: ClassVar[int] = 500
    code: ClassVar[str] = "internal-error"
    title: ClassVar[str] = "Internal server error"

    def __init__(self, detail: str | None = None) -> None:
        super().__init__(detail or self.title)
        self.detail = detail


class BadRequestError(AppError):
    status_code = 400
    code = "bad-request"
    title = "Bad request"


class NotFoundError(AppError):
    status_code = 404
    code = "not-found"
    title = "Resource not found"


class ConflictError(AppError):
    status_code = 409
    code = "conflict"
    title = "Conflict with the current state of the resource"


class UnprocessableError(AppError):
    """The request is well-formed but breaks a business rule."""

    status_code = 422
    code = "unprocessable"
    title = "Request cannot be processed"


class UpstreamError(AppError):
    """An external service (e.g. Open Beauty Facts) failed or timed out."""

    status_code = 502
    code = "upstream-error"
    title = "An upstream service failed"
</file>

<file path="backend/src/app/core/i18n.py">
"""Locale resolution and translation fallback.

Supported languages are listed in ONE place: add "ar" to `SUPPORTED_LOCALES` when
Arabic content exists (and nowhere else).
"""

from collections.abc import Mapping

DEFAULT_LOCALE = "en"
SUPPORTED_LOCALES: tuple[str, ...] = ("en", "fr")


def resolve_locale(accept_language: str | None) -> str:
    """Pick the best supported locale from an `Accept-Language` header value.

    "fr-FR,fr;q=0.9,en;q=0.8" -> "fr". Unsupported, empty or malformed input -> "en".
    Never raises: a weird header must never break a request.
    """
    if not accept_language:
        return DEFAULT_LOCALE

    candidates: list[tuple[float, int, str]] = []  # (-quality, original order, language)
    for order, part in enumerate(accept_language.split(",")):
        tag, *params = part.strip().split(";")
        tag = tag.strip().lower()
        if not tag or tag == "*":
            continue
        quality = 1.0
        for param in params:
            name, _, value = param.strip().partition("=")
            if name.strip().lower() == "q":
                try:
                    quality = float(value)
                except ValueError:
                    quality = 0.0
        if quality > 0:
            candidates.append((-quality, order, tag.split("-")[0]))

    for _, _, language in sorted(candidates):
        if language in SUPPORTED_LOCALES:
            return language
    return DEFAULT_LOCALE


def pick_translation[T](translations: Mapping[str, T], locale: str) -> T | None:
    """Return text for `locale`, else English, else any available value, else None.

    Pure helper for category names, ingredient rationales, and similar locale maps.
    """
    if locale in translations:
        return translations[locale]
    if DEFAULT_LOCALE in translations:
        return translations[DEFAULT_LOCALE]
    for value in translations.values():
        return value
    return None
</file>

